<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.GameActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/partie_marge"
        android:paddingTop="@dimen/partie_marge"
        android:paddingEnd="@dimen/partie_marge"
        android:paddingBottom="@dimen/partie_marge_petite">

        <TextView
            android:id="@+id/nom_adversaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_adversaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <fr.mines.philidor.vue.EchiquierView
        android:id="@+id/echiquier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/partie_marge"
        android:paddingTop="@dimen/partie_marge_petite"
        android:paddingEnd="@dimen/partie_marge">

        <TextView
            android:id="@+id/nom_joueur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_joueur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/statut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/partie_marge_petite"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <HorizontalScrollView
        android:id="@+id/defilement_coups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/partie_marge_petite"
        android:paddingStart="@dimen/partie_marge"
        android:paddingEnd="@dimen/partie_marge"
        android:scrollbars="none">

        <TextView
            android:id="@+id/liste_coups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </HorizontalScrollView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/but_annuler"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/partie_marge"
        android:text="@string/partie_annuler" />
</LinearLayout>
